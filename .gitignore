# Gradle / build output
build/
.gradle/
!gradle/wrapper/gradle-wrapper.jar

# Dev run directory (worlds, logs, configs)
run/
logs/

# IDE
.idea/
*.iml

# The one dependency that cannot come from maven (see libs/README.md for why, and for how to build
# it). Its jar is All Rights Reserved and must never be committed.
libs/*.jar

# Where tools/fetch-thaumaturge.* checks Thaumaturge out. CI points it at the workspace root so the
# path is stable for the run; it is deliberately not cached (see .github/workflows/build.yml, which
# explains why a Thaumaturge checkout must not end up in this repository's Actions cache). Not a
# dot-directory: Gradle refuses to configure a project whose directory name begins with a dot.
thaumaturge-src/

# JVM crash logs
hs_err_pid*.log
replay_pid*.log
*.log

# Working notes for whoever is picking the tree up locally: the comment conventions checklist and the
# arcane crafting terminal's design notes. Neither is the mod's source nor anything a player or a
# pack author needs, so they stay out of the public repository and live on disk only.
docs/

# Storefront copy, in the same category: it is written to be pasted into a mod listing, not to be
# read from the repository, and it lives on disk only.
MOD-DESCRIPTION.md
MOD-DESCRIPTION.en.md

# Scratch space for javap dumps and other throwaway evidence gathered while reading a dependency.
_scratch/
