# Gradle / build output
build/
.gradle/
!gradle/wrapper/gradle-wrapper.jar

# Dev run directory (worlds, logs, configs)
run/
logs/

# IDE
.idea/
*.iml

# The one dependency that cannot come from maven (see libs/README.md for why, and for how to build
# it). Its jar is All Rights Reserved and must never be committed.
libs/*.jar

# Where tools/fetch-thaumaturge.* checks Thaumaturge out. CI keeps it under the workspace so the
# actions/cache step can carry it between runs.
.thaumaturge-src/

# JVM crash logs
hs_err_pid*.log
replay_pid*.log
*.log
